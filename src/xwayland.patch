+
+/* Workspace-only rootful bridge: one client controls its host Wayland window. */
+void
+xwl_window_host_action(struct xwl_window *w, uint32_t action, uint32_t a, uint32_t b)
+{
+    struct xwl_screen *screen = w->xwl_screen;
+    struct xwl_seat *seat;
+    if (!w->xdg_toplevel || screen->rootless)
+        return;
+    switch (action) {
+    case 1: case 2:
+        xorg_list_for_each_entry(seat, &screen->seat_list, link) {
+            if (seat->host_button_serial && seat->focus_window == w) {
+                if (action == 1)
+                    xdg_toplevel_move(w->xdg_toplevel, seat->seat, seat->host_button_serial);
+                else
+                    xdg_toplevel_resize(w->xdg_toplevel, seat->seat, seat->host_button_serial, a);
+                break;
+            }
+        }
+        break;
+    case 3: xdg_toplevel_set_maximized(w->xdg_toplevel); break;
+    case 4: xdg_toplevel_unset_maximized(w->xdg_toplevel); break;
+    case 5: xdg_toplevel_set_minimized(w->xdg_toplevel); break;
+    case 6:
+        screen->runelite_client_chrome = TRUE;
+        if (w->server_decoration)
+            zxdg_toplevel_decoration_v1_set_mode(w->server_decoration, ZXDG_TOPLEVEL_DECORATION_V1_MODE_CLIENT_SIDE);
+        break;
+    case 8:
+        xwl_window_maybe_resize(w, a, b);
+        break;
+    case 9:
+        xdg_toplevel_set_min_size(w->xdg_toplevel,
+            (a + screen->global_surface_scale - 1) / screen->global_surface_scale,
+            (b + screen->global_surface_scale - 1) / screen->global_surface_scale);
+        break;
+    }
+    wl_surface_commit(w->surface);
+    wl_display_flush(screen->display);
+}
