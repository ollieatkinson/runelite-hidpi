+            zxdg_toplevel_decoration_v1_add_listener(xwl_window->server_decoration, &server_decoration_listener, xwl_window);
+            zxdg_toplevel_decoration_v1_set_mode(xwl_window->server_decoration, xwl_screen->runelite_client_chrome ? ZXDG_TOPLEVEL_DECORATION_V1_MODE_CLIENT_SIDE : ZXDG_TOPLEVEL_DECORATION_V1_MODE_SERVER_SIDE);
