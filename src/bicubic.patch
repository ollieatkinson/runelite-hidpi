+/* The public Glamor getter accepts texture-only pixmaps; our window backing
+ * and presentation buffers are GBM-backed GLAMOR_TEXTURE_DRM pixmaps. */
+uint32_t
+xwl_glamor_pixmap_texture(PixmapPtr pixmap)
+{
+    struct xwl_pixmap *private = xwl_pixmap_get(pixmap);
+    return private ? private->texture : glamor_get_pixmap_texture(pixmap);
+}
